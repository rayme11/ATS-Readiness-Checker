# ──────────────────────────────────────────────────────────────────────────────
# ATS Insight — Environment Configuration
#
# Copy this file to .env in the project root and fill in any values you need.
# Lines starting with # are comments and are ignored.
# ──────────────────────────────────────────────────────────────────────────────

# AI Provider
# -----------
# Controls which AI backend is used when the user clicks "Analyze Resume".
#
# "none"   → rule-based analysis only (default, no LLM calls, 100% free)
# "ollama" → free local inference — requires Ollama running on this machine
# "openai" → cloud inference — requires your personal OpenAI API key below
#
AI_PROVIDER=none

# ── Ollama (free, local) ───────────────────────────────────────────────────────
# Only used when AI_PROVIDER=ollama
# Install: https://ollama.ai   |   Start: ollama serve   |   Pull: ollama pull llama3
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── OpenAI (bring-your-own-key) ────────────────────────────────────────────────
# Only used when AI_PROVIDER=openai
# Get a key: https://platform.openai.com/api-keys
# ⚠️  A ChatGPT Plus subscription does NOT give you API access — separate billing.
# NEVER commit your actual key to version control.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Groq (bring-your-own-key, FREE developer tier available) ──────────────────
# Only used when AI_PROVIDER=groq
# Free tier: https://console.groq.com  — no credit card required
# Uses open-source models (llama3, mixtral, gemma2) via Groq’s fast inference cloud.
# Works for both local AND hosted deployments of this app.
# NEVER commit your actual key to version control.
GROQ_API_KEY=
GROQ_MODEL=llama3-8b-8192

# ── Anthropic Claude (bring-your-own-key, pay-per-use) ──────────────────────
# Only used when AI_PROVIDER=anthropic
# Get a key: https://console.anthropic.com
# ⚠️  A Claude.ai Pro subscription does NOT give you API access — separate billing.
# NEVER commit your actual key to version control.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307
