# ──────────────────────────────────────────────────────────────────────────────
# ATS Insight — Environment Configuration
#
# Copy this file to .env in the project root and fill in any values you need.
# Lines starting with # are comments and are ignored.
# ──────────────────────────────────────────────────────────────────────────────

# AI Provider
# -----------
# Controls which AI backend is used when the user clicks "Analyze Resume".
#
# "none"   → rule-based analysis only (default, no LLM calls, 100% free)
# "ollama" → free local inference — requires Ollama running on this machine
# "openai" → cloud inference — requires your personal OpenAI API key below
#
AI_PROVIDER=none

# ── Ollama (free, local) ───────────────────────────────────────────────────────
# Only used when AI_PROVIDER=ollama
# Install: https://ollama.ai   |   Start: ollama serve   |   Pull: ollama pull llama3
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── OpenAI (bring-your-own-key) ────────────────────────────────────────────────
# Only used when AI_PROVIDER=openai
# Get a key: https://platform.openai.com/api-keys
# NEVER commit your actual key to version control.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
